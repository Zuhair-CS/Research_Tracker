# ---------------------------------------------------------------------------
# PB-1 Publication Tracker - environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# SECURITY: never put real passwords or keys in this file - it is committed.
# In CI/CD the same variables come from GitHub Secrets / Environments.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database (used by the API and by docker-compose) ----------------------
POSTGRES_USER=pubtrack
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=pubtrack
DATABASE_URL=postgresql://pubtrack:change-me-db-password@localhost:5432/pubtrack

# --- Sessions ---------------------------------------------------------------
# Long random string used to sign the session cookie (min 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Only send the cookie over HTTPS. The app REFUSES to start in production
# (NODE_ENV=production) unless this is true. Set it to false only for local
# development over plain http://localhost, where there is no HTTPS.
COOKIE_SECURE=false
# Number of reverse proxies in front of the app (0 locally, 1 behind nginx/Caddy).
TRUST_PROXY=0

# --- CORS allow-list (comma separated). Only these origins may call the API. --
CORS_ORIGINS=http://localhost:5173

# --- External scholarly APIs ----------------------------------------------
# Crossref and OpenAlex ask clients to identify themselves with a contact e-mail.
API_CONTACT_EMAIL=your-email@university.edu
CROSSREF_API_BASE=https://api.crossref.org
ORCID_API_BASE=https://pub.orcid.org/v3.0
OPENALEX_API_BASE=https://api.openalex.org
# Optional but recommended: a FREE OpenAlex key (https://openalex.org/settings/api).
# Without it, everyone on your network shares a small daily request budget.
# SECRET - keep it only in .env / GitHub Secrets.
OPENALEX_API_KEY=
# Optional: your university's OpenAlex institution id, to search only its researchers.
# Find it at https://api.openalex.org/institutions?search=Your%20University (the I... id).
OPENALEX_INSTITUTION_ID=I5847235
# Other names the university appears under in publisher affiliations (used to filter Crossref results).
INSTITUTION_ALIASES=UPES,University of Petroleum and Energy Studies,University of Petroleum & Energy Studies

# --- Sign-up -----------------------------------------------------------------
# New accounts start read-only; an admin approves Faculty/Student access.
SIGNUP_ENABLED=true
# Only these e-mail domains may sign up (comma separated). Empty = any domain (dev only).
SIGNUP_ALLOWED_DOMAINS=

# --- Seed accounts (only used by `npm run db:seed`) -------------------------
SEED_ADMIN_EMAIL=admin@university.edu
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_RESEARCHER_EMAIL=researcher@university.edu
SEED_RESEARCHER_PASSWORD=change-me-researcher-password
SEED_VIEWER_EMAIL=viewer@university.edu
SEED_VIEWER_PASSWORD=change-me-viewer-password
