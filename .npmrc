# SECURITY: pin exact versions when adding packages (no "^" ranges), so a
# compromised new release of a dependency is never pulled in silently.
# Upgrades happen on purpose, through Dependabot pull requests (Phase 4).
save-exact=true
# Fail installs when the Node/npm version does not match "engines".
engine-strict=true
# Refuse to install from anywhere except the official npm registry.
registry=https://registry.npmjs.org/
